# Copy to .env and fill in. This file is read by the server only; keys are never sent to the browser.

# --- Search (at least one is required) -------------------------------------
# Tavily web search: https://app.tavily.com  (free plan: 1,000 credits/month)
TAVILY_API_KEY=
# SerpApi: Google Shopping Canada prices + Google web results: https://serpapi.com (free plan: 250 searches/month)
SERPAPI_API_KEY=
# Optional SerpApi location string, e.g. "Thunder Bay,Ontario,Canada" (must match SerpApi's Locations API)
SERPAPI_LOCATION=

# Which web search to use when several keys are set: auto | tavily | serpapi | anthropic
PI_SEARCH_PROVIDER=auto

# --- Optional AI reading (Claude) - the same key also enables Anthropic web search ---
# Enables plain-language understanding, price extraction from page text and review summaries.
# Every AI-extracted fact is verified word-for-word against the source text.
ANTHROPIC_API_KEY=
# Model and effort (defaults shown). Lower effort or a smaller model costs less.
PI_ANTHROPIC_MODEL=claude-opus-5-5
PI_ANTHROPIC_EFFORT=medium
# Effort for Anthropic web-search calls (retrieval only)
PI_SEARCH_EFFORT=low

# --- Page reading -------------------------------------------------------------
# Read supplier product pages directly for structured price data (schema.org).
FETCH_PAGES=true
FETCH_MAX_PAGES=10
FETCH_TIMEOUT_S=8
RESPECT_ROBOTS_TXT=true
# Proxy-only networks: if this server can't resolve public host names itself (an HTTPS proxy does it),
# set true to allow public-looking names that fail local DNS. Internal names and IPs stay blocked.
FETCH_TRUST_PROXY_DNS=false
# If this server can't connect to a supplier page or the Bank of Canada (DNS, network or timeout - never a
# site's own refusal or robots.txt "no"), read it through Anthropic's web fetch tool instead. Needs the
# Anthropic key; robots.txt is fetched the same way and obeyed. Measured: about US$0.06 per page including
# its robots.txt on Claude Opus 5.5 (the page text is billed as input tokens). Copies can be cached; prices
# read from an old copy are dated and flagged.
FETCH_VIA_ANTHROPIC=true
FETCH_VIA_ANTHROPIC_MAX=4
# Model that issues those fetches (it only calls the tool; the app parses the result). Default: PI_ANTHROPIC_MODEL.
# claude-haiku-5-5 costs far less per page.
PI_FETCH_MODEL=

# --- Other ----------------------------------------------------------------------
# Where the SQLite database lives (default: ./data/purchasing.db)
DATABASE_PATH=
# Re-running the same search within this many hours offers the saved result first
DUPLICATE_WINDOW_HOURS=12
# Province for tax notes (ON = 13% HST)
HOME_PROVINCE=ON
SEARCH_TIMEOUT_S=25
# A whole research job is stopped after this many seconds
JOB_TIMEOUT_S=420
# Server bind address. 127.0.0.1 = this computer only. The app has no login in Phase 1;
# only expose it on a trusted internal network (or behind your company sign-in proxy).
HOST=127.0.0.1
PORT=8000
